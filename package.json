{
  "name": "outfitly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && prettier --check .",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @outfitly/db generate",
    "db:migrate": "pnpm --filter @outfitly/db migrate",
    "db:seed": "pnpm --filter @outfitly/db seed",
    "seed:looks": "pnpm --filter @outfitly/api seed-looks",
    "seed:fake-looks": "pnpm --filter @outfitly/api fake-looks",
    "feed:speed": "pnpm --filter @outfitly/api feed-speed",
    "search:speed": "pnpm --filter @outfitly/api search-speed",
    "dev:api": "pnpm --filter @outfitly/api dev",
    "media:try": "pnpm --filter @outfitly/api try-upload",
    "ai:spot-check": "pnpm --filter @outfitly/api ai-spot-check",
    "links:try": "pnpm --filter @outfitly/api links-try",
    "seed:items": "pnpm --filter @outfitly/api seed-items",
    "links:calibrate": "pnpm --filter @outfitly/api links-calibrate",
    "embedder:test": "cd services/embedder && uv run pytest",
    "embedder:speed": "cd services/embedder && uv run --env-file ../../.env python scripts/speed.py",
    "dev:app": "pnpm --filter @outfitly/mobile start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "~17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1"
  }
}

# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Staging and production values live in Fly.io / EAS secrets, not in files.
# Every step that needs a new setting adds it here, with a comment.

NODE_ENV=development

# --- Database (Step 1.2) ---
# Supabase dev project → Connect → "Session pooler" (port 5432) or "Direct connection".
# Never the transaction pooler (port 6543): background jobs need real sessions.
# Leave `sslmode` out of the URL; TLS is set up from DATABASE_CA_CERT instead.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
# Supabase → Database settings → SSL configuration → Download certificate. Paste the PEM in quotes.
DATABASE_CA_CERT=
# A local Postgres 17 + pgvector server for tests (must be localhost). Tests create and drop
# their own databases. Homebrew Postgres uses your Mac username with no password.
TEST_DATABASE_URL=postgres://localhost:5432/postgres
# Supabase dev project → Project Settings → API. The API checks login tokens against SUPABASE_URL;
# the publishable key is only used by the live "public key can't read" test.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# --- API (Step 1.3) ---
PORT=8080
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=300
# Sentry → project "outfitly-api" → Client Keys (DSN). Leave empty to turn Sentry off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Photos (Step 1.4) ---
# Cloudflare → R2 → Manage API tokens → "Object Read & Write" for the two buckets.
R2_ACCOUNT_ID=
# Buckets are created in the EU jurisdiction, which has its own endpoint ("default" = non-EU).
R2_JURISDICTION=eu
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private: originals as uploaded. Never public.
R2_ORIGINALS_BUCKET=outfitly-originals-dev
# Public: the 1080/600/300 WebP sizes, served through Cloudflare on the image domain.
R2_PUBLIC_BUCKET=outfitly-public-dev
# Until we have a domain: the public bucket's "Public Development URL" (https://pub-….r2.dev).
MEDIA_PUBLIC_BASE_URL=https://img.outfitly.com

# --- App (Step 1.5) --- (EAS build env, or apps/mobile/.env for local dev builds)
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_SENTRY_DSN=
# --- Login in the app (Step 1.6) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Printed by `eas init`.
EAS_PROJECT_ID=
# For uploading app source maps to Sentry during EAS builds (+ SENTRY_AUTH_TOKEN as an EAS secret).
SENTRY_ORG=
SENTRY_PROJECT=outfitly-app

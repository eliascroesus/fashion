# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Staging and production values live in Fly.io / EAS secrets, not in files.
# Every step that needs a new setting adds it here, with a comment.

NODE_ENV=development

# --- Database (Step 1.2) ---
# Supabase dev project → Connect → "Session pooler" (port 5432) or "Direct connection".
# Never the transaction pooler (port 6543): background jobs need real sessions.
# Leave `sslmode` out of the URL; TLS is set up from DATABASE_CA_CERT instead.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
# Supabase → Database settings → SSL configuration → Download certificate. Paste the PEM in quotes.
DATABASE_CA_CERT=
# A local Postgres 17 + pgvector server for tests (must be localhost). Tests create and drop
# their own databases. Homebrew Postgres uses your Mac username with no password.
TEST_DATABASE_URL=postgres://localhost:5432/postgres
# Supabase dev project → Project Settings → API. Only used by the live "public key can't read" test.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

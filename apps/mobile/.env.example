# Copy to apps/mobile/.env for local dev builds (Expo reads only this folder's .env).
# Only EXPO_PUBLIC_* values reach the app, and they are public: never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_SENTRY_DSN=
# Supabase project (login only; data goes through the API). The publishable key is public.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (CAPTCHA for guest and email sign-ins). Empty = no CAPTCHA.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# The page address the CAPTCHA runs on; must be an allowed hostname of the Turnstile widget.
EXPO_PUBLIC_TURNSTILE_ORIGIN=https://outfitly.com

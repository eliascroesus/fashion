{
  "name": "@outfitly/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import ./src/instrument.ts src/server.ts",
    "start": "node --import ./src/instrument.ts src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "try-upload": "node --env-file-if-exists=../../.env scripts/try-upload.ts",
    "seed-looks": "node --env-file-if-exists=../../.env scripts/seed-looks.ts",
    "fake-looks": "node --env-file-if-exists=../../.env scripts/fake-looks.ts",
    "feed-speed": "node --env-file-if-exists=../../.env scripts/feed-speed.ts",
    "search-speed": "node scripts/search-speed.ts",
    "ai-spot-check": "node --env-file-if-exists=../../.env scripts/ai-spot-check.ts",
    "links-try": "node --env-file-if-exists=../../.env scripts/links-try.ts",
    "seed-items": "node --env-file-if-exists=../../.env scripts/seed-items.ts",
    "links-calibrate": "node --env-file-if-exists=../../.env scripts/links-calibrate.ts",
    "shop-test-look": "node --env-file-if-exists=../../.env scripts/shop-test-look.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@fastify/rate-limit": "^11.2.1",
    "@outfitly/db": "workspace:*",
    "@outfitly/shared": "workspace:*",
    "@sentry/node": "^11.10.0",
    "fastify": "^5.12.7",
    "heic-decode": "^2.1.0",
    "jose": "~6.2.14",
    "pg-boss": "^12.38.0",
    "sharp": "^0.35.5",
    "thumbhash": "^0.1.1",
    "zod": "^4.6.7"
  }
}
